# Copy to .env.local, edit locally, then load with:
# set -a; source .env.local; set +a
# Never commit .env.local.
OPENAI_API_KEY=
SO101_OPENAI_MODEL=gpt-5.5
# Prefer /dev/serial/by-id/... for stable device paths on your machine.
SO101_FOLLOWER_PORT=/dev/ttyACM0
SO101_LEADER_PORT=/dev/ttyACM1
SO101_FOLLOWER_ID=my_follower
SO101_LEADER_ID=my_leader
SO101_HEAD_CAMERA_SERIAL=
SO101_WRIST_CAMERA_SERIAL=
# Optional overrides (otherwise standard LeRobot cache and repo checkpoint paths):
# SO101_FOLLOWER_CALIB=/absolute/path/to/follower.json
# SO101_LEADER_CALIB=/absolute/path/to/leader.json
# Defaults: coordinate controller uses the simulation policy; AI agent uses the real-arm policy.
# Set this to override both with your own exported policy.
# SO101_POLICY_DIR=/absolute/path/to/exported_policy
# SO101_LEROBOT_PYTHON=/absolute/path/to/lerobot/environment/bin/python
